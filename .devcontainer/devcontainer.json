{
    "name": "openrb-pico",
    // Prebuilt dev image published by .github/workflows/devcontainer-image.yml. Pulls
    // instead of building locally; to iterate on the Dockerfile itself, temporarily
    // swap this for `"build": { "dockerfile": "Dockerfile" }`.
    "image": "ghcr.io/delabrcd/openrb-pico-dev:latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cmake-tools",
                "llvm-vs-code-extensions.vscode-clangd",
                "marus25.cortex-debug"
            ],
            "settings": {
                "cmake.configureArgs": [
                    "-DPICO_SDK_PATH=${workspaceFolder}/external/pico-sdk"
                ]
            }
        }
    },
    // Submodules carry the Pico SDK, tinyusb, Pico-PIO-USB, and usb_midi_host.
    "postCreateCommand": "git submodule update --init --recursive"
}
